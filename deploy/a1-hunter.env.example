# ~/.a1-hunter.env on the VM (not committed). OCIDs of your own tenancy.
A1_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxxx
A1_SUBNET_ID=ocid1.subnet.oc1.eu-frankfurt-1.xxxxxxxx
A1_ADS=xxxx:EU-FRANKFURT-1-AD-1,xxxx:EU-FRANKFURT-1-AD-2,xxxx:EU-FRANKFURT-1-AD-3
# Same key as the hub VM, so the new instance accepts the same SSH key.
A1_SSH_PUBLIC_KEY_FILE=/home/ubuntu/.ssh/authorized_keys
# Largest first; each is tried in every AD.
A1_SHAPES=2:12,1:6
A1_DISPLAY_NAME=redmond-a1
# Optional: pin an image; empty = newest Canonical Ubuntu 24.04 aarch64.
A1_IMAGE_ID=
