# Redmond Cloud — environment template.
# Copy to .env, fill values, NEVER commit .env to git.

# --- Telegram bot tokens (4 separate bots in one group) ---
TELEGRAM_BOT_TOKEN=     # Redmond — @redmond_hub_bot (primary listener + router)
IRIS_BOT_TOKEN=         # Iris    — @iris_redberry_bot
CIPHER_BOT_TOKEN=       # Cipher  — @cipher_redberry_bot
NEWSER_BOT_TOKEN=       # Newser  — @newser_redmond_bot

# --- Authorization ---
ALLOWED_USER_IDS=       # Comma-separated owner Telegram user IDs (e.g. "123456789")
MAIN_CHAT_ID=           # Telegram group chat_id (negative for supergroups, e.g. "-1001234567890")

# --- LLM providers ---
REDMOND_GROQ_API_KEY=   # Groq API key (free tier — https://console.groq.com)
REDMOND_GEMINI_API_KEY= # Gemini API key (optional fallback)

# --- Web search (optional, DDG fallback works without these) ---
REDMOND_GOOGLE_API_KEY=
REDMOND_GOOGLE_SEARCH_ENGINE_ID=
